{
  "name": "cordis-plugin-social-browser-local",
  "version": "0.1.0",
  "description": "Local Chrome and Edge browser provider for Cordis social plugins",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": { ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" }, "./package.json": "./package.json" },
  "files": ["lib", "README.md", "LICENSE"],
  "scripts": { "build": "tsup src/index.ts --format esm --dts --clean --out-dir lib", "typecheck": "tsc --noEmit -p tsconfig.json" },
  "keywords": ["cordis", "chrome", "edge", "playwright", "social-media"],
  "repository": { "type": "git", "url": "git+https://github.com/enginefuture/cordis-social.git", "directory": "packages/local-browser" },
  "homepage": "https://github.com/enginefuture/cordis-social#readme",
  "bugs": "https://github.com/enginefuture/cordis-social/issues",
  "publishConfig": { "access": "public" },
  "cordis": { "description": { "en": "Local system-browser provider", "zh": "本地系统浏览器提供器" } },
  "peerDependencies": { "cordis": "4.0.0-rc.9", "playwright-core": ">=1.62.1" },
  "dependencies": { "cordis-plugin-social-browser": "workspace:^", "zod": "^4.1.11" },
  "devDependencies": { "cordis": "4.0.0-rc.9", "playwright-core": "^1.62.1", "tsup": "^8.5.0", "typescript": "^5.9.2" }
}
